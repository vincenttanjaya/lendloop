    {
      "id": "b8549c59-bfd8-45c6-b8f9-5d220d1bbcaa",
      "name": "Compose notification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        -100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Uses only the fields the message needs; nothing else from the payload leaves this node.\nconst { event, toolName, startDate, endDate, actorName, recipient } = $json.payload;\nconst dates = `${startDate} to ${endDate}`;\nconst templates = {\n  requested: `${actorName} asked to borrow your ${toolName} (${dates}).`,\n  approved: `${actorName} approved your request for the ${toolName} (${dates}).`,\n  declined: `${actorName} declined your request for the ${toolName} (${dates}).`,\n  // cancelled and returned go to whichever party did not act (lender or borrower), so they read both ways.\n  cancelled: `${actorName} cancelled the request for the ${toolName} (${dates}).`,\n  returned: `${actorName} marked the ${toolName} as returned.`,\n};\nconst body = templates[event];\nif (!body) throw new Error(`Unknown loan event: ${event}`);\nreturn { json: { to: recipient.clerkId, message: `Hi ${recipient.name}, ${body}` } };"
      }
    },
    {
