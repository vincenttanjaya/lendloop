      "id": "db78704d-6fd1-4416-9f25-4b1ffae13a59",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Verifies X-LendLoop-Signature = \"sha256=\" + hex(HMAC-SHA256(secret, `${timestamp}.${rawBody}`)).\nconst crypto = require('crypto');\nconst secret = $env.LENDLOOP_WEBHOOK_SECRET;\nif (!secret) throw new Error('LENDLOOP_WEBHOOK_SECRET is not set');\n\nconst item = $input.first();\nconst timestamp = item.json.headers['x-lendloop-timestamp'];\nconst signature = item.json.headers['x-lendloop-signature'];\n// Raw body bytes exactly as Convex signed them (Webhook node option \"Raw Body\").\nconst rawBody = Buffer.from(item.binary?.data?.data ?? '', 'base64').toString('utf8');\n\nlet reason = null;\nif (!timestamp || !signature) {\n  reason = 'missing';\n} else if (!(Math.abs(Date.now() - Number(timestamp)) <= 300000)) {\n  reason = 'stale'; // also rejects non-numeric timestamps (NaN)\n} else {\n  const expected = Buffer.from('sha256=' + crypto.createHmac('sha256', secret).update(`${timestamp}.${rawBody}`).digest('hex'));\n  const given = Buffer.from(String(signature));\n  if (expected.length !== given.length || !crypto.timingSafeEqual(expected, given)) reason = 'mismatch';\n}\n\nconst valid = reason === null;\nreturn [{ json: { valid, reason, payload: valid ? JSON.parse(rawBody) : null } }];"
      }
    },
    {
