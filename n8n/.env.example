# Copy to n8n/.env (git-ignored). Generate values with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# Must equal LENDLOOP_WEBHOOK_SECRET in the Convex deployment env.
LENDLOOP_WEBHOOK_SECRET=
# Convex HTTP actions origin (local `npx convex dev` serves it on port 3211).
CONVEX_SITE_URL=http://host.docker.internal:3211
